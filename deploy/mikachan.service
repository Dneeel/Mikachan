# Managed by Mikachan panel
[Unit]
Description=Mikachan private Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mikachan
Group=mikachan
WorkingDirectory=/opt/Mikachan/current
EnvironmentFile=/opt/Mikachan/config/bot.env
Environment=PATH=/opt/Mikachan/current/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/opt/Mikachan/state
Environment=TMPDIR=/opt/Mikachan/tmp/runtime
Environment=XDG_CACHE_HOME=/opt/Mikachan/cache
ExecStart=/usr/bin/flock -n /opt/Mikachan/state/polling.lock /opt/Mikachan/current/.venv/bin/mikachan run
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/Mikachan/state /opt/Mikachan/tmp/runtime /opt/Mikachan/cache /opt/Mikachan/logs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
