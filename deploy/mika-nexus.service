[Unit]
Description=MIKA NEXUS private Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mika-nexus
Group=mika-nexus
WorkingDirectory=/opt/mika-nexus
EnvironmentFile=/etc/mika-nexus.env
Environment=PATH=/opt/mika-nexus/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/mika-nexus/.venv/bin/mika-nexus run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mika-nexus
PrivateTmp=true

[Install]
WantedBy=multi-user.target
