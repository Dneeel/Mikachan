# Managed by Mikachan panel
[Unit]
Description=Mikachan private Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mika-nexus
Group=mika-nexus
WorkingDirectory=/opt/mika-nexus/current
EnvironmentFile=/etc/mika-nexus.env
Environment=PATH=/opt/mika-nexus/current/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/flock -n /var/lib/mika-nexus/polling.lock /opt/mika-nexus/current/.venv/bin/mika-nexus run
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mika-nexus
PrivateTmp=true

[Install]
WantedBy=multi-user.target
